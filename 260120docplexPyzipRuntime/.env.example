# watsonx.ai 認証情報
# このファイルを .env にコピーして、実際の値を設定してください

# IBM Cloud APIキー
# 取得方法: https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your_api_key_here

# watsonx.ai インスタンスURL
# 例: https://jp-tok.ml.cloud.ibm.com (東京リージョン)
# 例: https://us-south.ml.cloud.ibm.com (米国南部リージョン)
WATSONX_INSTANCE_URL=https://jp-tok.ml.cloud.ibm.com

# watsonx.ai スペースID
# watsonx.aiのスペース設定から取得できます
WATSONX_SPACE_ID=your_space_id_here